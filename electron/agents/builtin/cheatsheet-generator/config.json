{
  "id": "agent_cheatsheet",
  "name": "速查表生成器",
  "english_name": "cheatsheet-generator",
  "description": "把资料中的公式、关键数据、步骤、规则和易错点浓缩成一页式速查表。",
  "icon": "ri-file-list-3-line",
  "color": "#F59E0B",
  "architecture": "plan_exec",
  "builtin": true,
  "category": "创作中心",
  "single_shot": true,
  "output_format": "json",
  "output_schema": "cheatsheet",
  "permissions": {
    "fileRead": true,
    "fileWrite": false,
    "webSearch": true,
    "fileDelete": false,
    "fileRename": false,
    "execCommand": false
  },
  "tools": ["mcp:exa", "file_read", "document_read", "media_read", "kb_search"],
  "skills": [],
  "sub_agents": [],
  "max_iterations": 1,
  "retrieval_iterations": 3,
  "follow_up_evidence_call_limit": 20,
  "plan_steps": 1,
  "temperature": 0.2,
  "max_tokens": 8192,
  "thinking_mode": "off",
  "thinking_intensity": "medium",
  "hard_timeout_ms": 180000,
  "required_tools": [],
  "prompt_file": "orchestrator.md",
  "subagent_dir": "subagents",
  "artifact_rules_file": "artifact-rules.json"
}
