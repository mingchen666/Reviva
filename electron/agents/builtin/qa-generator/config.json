{
  "id": "agent_qa",
  "name": "Q&A 问答卡",
  "english_name": "qa-generator",
  "description": "根据主题或资料生成可检索的 FAQ 与启发思考问答对，输出结构化 JSON 数据。",
  "icon": "ri-question-answer-line",
  "color": "#4A6CFF",
  "architecture": "plan_exec",
  "builtin": true,
  "category": "创作中心",
  "single_shot": true,
  "output_format": "json",
  "output_schema": "qa",
  "permissions": {
    "fileRead": true,
    "fileWrite": false,
    "webSearch": true,
    "fileDelete": false,
    "fileRename": false,
    "execCommand": false
  },
  "tools": ["mcp:exa", "file_read", "document_read", "media_read", "kb_search"],
  "skills": [],
  "sub_agents": [],
  "max_iterations": 1,
  "retrieval_iterations": 3,
  "follow_up_evidence_call_limit": 20,
  "plan_steps": 1,
  "temperature": 0.25,
  "max_tokens": 8192,
  "thinking_mode": "off",
  "thinking_intensity": "medium",
  "hard_timeout_ms": 180000,
  "required_tools": [],
  "prompt_file": "orchestrator.md",
  "subagent_dir": "subagents",
  "artifact_rules_file": "artifact-rules.json"
}
